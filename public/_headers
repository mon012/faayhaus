# Media filenames come from the WordPress export and carry no content hash, so
# Cloudflare will not cache them aggressively without being told to. They are
# immutable in practice: a changed photo gets a new WordPress filename.
/media/*
  Cache-Control: public, max-age=31536000, immutable

/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-192.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-512.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/og-default.jpg
  Cache-Control: public, max-age=31536000, immutable

# Astro fingerprints everything it emits into _astro/.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
