---
import '../styles/global.css';
import { jsonLd } from '../lib';
const {
  title='FAAY HAUS®',
  description='Community-made objects for cooking, dining, and daily care.',
  image='/media/uploads/2023/03/faayhaus-main-scaled.jpg',
  preload,
  type='website',
  publishedTime,
  modifiedTime,
  schema=[],
}=Astro.props;
const path=Astro.url.pathname;
const absoluteImage=new URL(image,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={Astro.url}><meta property="og:type" content={type}><meta property="og:site_name" content="FAAY HAUS"><meta property="og:url" content={Astro.url}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={absoluteImage}>{type==='article'&&publishedTime&&<meta property="article:published_time" content={publishedTime}>}{type==='article'&&modifiedTime&&<meta property="article:modified_time" content={modifiedTime}>}<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}><meta name="twitter:image" content={absoluteImage}><link rel="icon" href="/media/uploads/2019/06/logo.png">{preload&&<link rel="preload" as="image" href={preload} fetchpriority="high">}{schema.map((item:unknown)=><script type="application/ld+json" is:inline set:html={jsonLd(item)} />)}</head><body>
<!-- BRAND FLOW: everyday need → useful design → material truth → community craft → continued use. FAAY HAUS spans Kitchenware, Tableware, and Bathing; product-level theses must not replace the master brand story. -->
<a class="skip" href="#content">Skip to content</a><header><a class="brand" href="/">FAAY HAUS<sup>®</sup></a><nav aria-label="Main"><a class:list={{active:path.startsWith('/products')||path.startsWith('/product/')}} href="/products/">Products</a><a href="/articles/">Ideas &amp; Guides</a><a href="/about/">About</a></nav><div class="header-tools"><a class="search" href="/products/" aria-label="Browse products"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg></a><details class="mobile-menu"><summary aria-label="Open menu"><span></span><span></span></summary><nav aria-label="Mobile"><a href="/products/">Products</a><a href="/articles/">Ideas &amp; Guides</a><a href="/about/">About</a></nav></details></div></header><main id="content"><slot/></main><footer><div><a class="brand" href="/">FAAY HAUS<sup>®</sup></a><p>Useful objects, shaped by community hands.</p></div><nav><a href="/products/">Products</a><a href="/articles/">Ideas &amp; Guides</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav><nav><a href="/shipping/">Shipping</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/return/">Returns</a></nav><small>© {new Date().getFullYear()} FAAY HAUS. All Rights Reserved.</small></footer></body></html>
