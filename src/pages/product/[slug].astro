---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import { localMedia, clean, money, prepareEmbeddedMedia, productSrcset } from '../../lib';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = products
  .filter((candidate) =>
    candidate.slug !== product.slug &&
    candidate.categories?.[0]?.slug === product.categories?.[0]?.slug
  )
  .slice(0, 3);
const summaryHtml = prepareEmbeddedMedia(product.summaryHtml);
const descriptionHtml = prepareEmbeddedMedia(product.descriptionHtml);
const totalImages = product.images?.length || 0;
const category = product.categories?.[0];
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: clean(product.name),
  description: clean(product.summaryHtml),
  image: (product.images || []).map((img) => new URL(localMedia(img.src), Astro.site).toString()),
  brand: { '@type': 'Brand', name: 'FAAY HAUS' },
  ...(product.sku ? { sku: product.sku } : {}),
  offers: {
    '@type': 'Offer',
    url: product.amazonUrl,
    priceCurrency: product.price?.currency_code,
    price: product.price?.price ? (Number(product.price.price) / 10 ** product.price.currency_minor_unit).toFixed(product.price.currency_minor_unit) : undefined,
    availability: product.isInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Products', item: new URL('/products/', Astro.site).toString() },
    ...(category ? [{ '@type': 'ListItem', position: 3, name: clean(category.name), item: new URL(`/product-category/${category.slug}/`, Astro.site).toString() }] : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: clean(product.name) },
  ],
};
---
<Base title={`${clean(product.name)} — FAAY HAUS®`} description={clean(product.summaryHtml)} image={localMedia(product.images?.[0]?.src)} schema={[productSchema, breadcrumbSchema]}><section class="product-detail"><div class="gallery"><img data-image-component class="gallery-main" src={localMedia(product.images?.[0]?.src)} srcset={productSrcset(product.images?.[0])} sizes="(max-width:900px) 100vw, 55vw" alt={product.images?.[0]?.alt||(totalImages>1?`${clean(product.name)}, photo 1 of ${totalImages}`:clean(product.name))} decoding="async" fetchpriority="high">{product.images?.slice(1,5).map((img,i)=><img data-image-component src={localMedia(img.src)} srcset={productSrcset(img)} sizes="(max-width:900px) 100vw, 55vw" alt={img.alt||`${clean(product.name)}, photo ${i+2} of ${totalImages}`} loading="lazy" decoding="async">)}</div><div class="product-info"><nav class="path" aria-label="Breadcrumb"><a href="/products/">Products</a>{category && <> / <a href={`/product-category/${category.slug}/`}>{clean(category.name)}</a></>}</nav><h1>{clean(product.name)}</h1><div class="summary" set:html={summaryHtml}/><p class="price">{money(product.price)} <span>Price shown as a reference; Amazon may change it.</span></p><a class="button amazon" href={product.amazonUrl} target="_blank" rel="sponsored nofollow noopener">View on Amazon <b>↗</b></a><p class="external-note">You’ll continue to Amazon to check availability, current pricing, shipping, and purchase.</p><div class="origin"><h2>Made with a human origin.</h2><p>Sustainably sourced teak is shaped and finished by hand. Natural grain and color variation make each piece its own.</p></div></div></section><section class="description"><h2>Made for the way it is used.</h2><div set:html={descriptionHtml}/></section>{related.length>0&&<section class="collection"><div class="section-head"><h2>More from this collection.</h2></div><div class="product-grid related">{related.map(p=><ProductCard product={p}/>)}</div></section>}</Base>
