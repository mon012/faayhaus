---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { categoryCopy, categoryOrder } from '../data/categories';
import { clean } from '../lib';

const groups = categoryOrder.map((slug) => {
  const items = products.filter((product) => product.categories?.some((category) => category.slug === slug));
  return {
    slug,
    name: clean(items[0]?.categories?.find((category) => category.slug === slug)?.name || slug),
    items,
    copy: categoryCopy[slug],
  };
}).filter((group) => group.items.length > 0);

// An ItemList tells Google this is a real catalog listing rather than a page
// that happens to contain product names, and lets the three category sections
// be understood as one ordered collection.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'FAAY HAUS catalog',
  numberOfItems: products.length,
  itemListElement: groups.flatMap((group) => group.items).map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/product/${product.slug}/`, Astro.site).toString(),
    name: clean(product.name),
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Products' },
  ],
};
---
<Base
  title="Teak Kitchen Utensils, Tableware & Bathing Goods | FAAY"
  description={`All ${products.length} FAAY HAUS pieces: hand-carved teak spatulas, spoons, ladles and loofah bath tools, grouped by how they are used. Each links out to Amazon.`}
  schema={[itemListSchema, breadcrumbSchema]}
>
  <section class="page-hero page-hero-products">
    <h1>Objects for daily rituals.</h1>
    <p>Spoons, ladles, and scrubbers shaped by hand from teak and loofah, ready for daily use. Product purchases open on Amazon.</p>
  </section>
  <nav class="category-jump" aria-label="Product categories">
    <span>Browse by category</span>
    <div>
      {groups.map((group) => <a href={`#${group.slug}`}>{group.name} <small>{group.items.length}</small></a>)}
    </div>
  </nav>
  <div class="grouped-catalog">
    {groups.map((group, groupIndex) => (
      <section class="product-group" id={group.slug}>
        <div class="product-group-heading">
          <div>
            <p>{String(group.items.length).padStart(2, '0')} products</p>
            <h2>{group.name}</h2>
          </div>
          <p>{group.copy.tagline}</p>
        </div>
        <div class="product-grid">{group.items.map((product, i) => <ProductCard product={product} priority={groupIndex === 0 && i < 4} />)}</div>
        <p class="group-more"><a class="text-link" href={`/product-category/${group.slug}/`}>More about {group.name.toLowerCase()} →</a></p>
      </section>
    ))}
  </div>
</Base>
