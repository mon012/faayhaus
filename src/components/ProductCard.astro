---
import {img,clean,money,productSrcset,productAlt} from '../lib';
const {product,priority=false}=Astro.props; const image=product.images?.[0]; const src=img(image?.src);
---
<article class="product-card"><a href={`/product/${product.slug}/`}><div class="product-image"><img data-image-component src={src} srcset={productSrcset(image)} sizes="(max-width:600px) 100vw, (max-width:900px) 50vw, 340px" alt={productAlt(product,image)} loading={priority?'eager':'lazy'} decoding="async" fetchpriority={priority?'high':'auto'}></div><h3>{clean(product.name)}</h3><p>{money(product.price)}</p><span class="text-link">View product <b>↗</b></span></a></article>
